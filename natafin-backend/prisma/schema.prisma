generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id               String   @id @default(uuid()) @db.Uuid
  description      String
  amount           Float
  category         String
  category_name    String
  transaction_date DateTime @db.Date

  @@map("transactions")
}
